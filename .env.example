# Copia este fichero a .env (o ejecuta `make init`, que genera secretos aleatorios).
# .env nunca debe versionarse.

# --- Plano de control -------------------------------------------------------
POSTGRES_PASSWORD=cambia-esto
KC_ADMIN_PASSWORD=cambia-esto

# Contraseña de los usuarios de demostración del realm (alice, bob, carol, dave, erin, frank).
# Debe cumplir la política del realm: >= 12 caracteres, mayúscula, minúscula, dígito y símbolo.
TFM_DEMO_PASSWORD=CambiaEsto2026!

# Secretos de los clientes confidenciales (identidad M2M de cada microservicio)
ORDERS_CLIENT_SECRET=cambia-esto
PAYMENTS_CLIENT_SECRET=cambia-esto
INVENTORY_CLIENT_SECRET=cambia-esto

# Secreto del cliente confidencial del BFF (Authorization Code + PKCE)
BFF_CLIENT_SECRET=cambia-esto

# Semilla TOTP compartida (secreto en claro) de los usuarios con MFA (erin, hector).
# En el PoC es fija para poder calcular el código OTP en las pruebas y en la consola;
# en un entorno real cada usuario la genera de forma privada al enrolar su 2.º factor.
# El código TOTP se calcula sobre Base32(UTF-8(este valor)).
TFM_MFA_SECRET=TfmMfaSharedSeed2026x

# --- Validación de tokens ---------------------------------------------------
OIDC_ISSUER=https://localhost:8443/auth/realms/tfm
OIDC_AUDIENCE=microservices-backend-api
